{
	# Solo se fía de la IP que manda cloudflared (red «tunel», IP fija). Nadie más, ni la wifi de casa,
	# puede inventarse su IP con CF-Connecting-IP para saltarse los límites por IP (V-17).
	servers {
		trusted_proxies static 172.31.253.3/32
		client_ip_headers CF-Connecting-IP
	}
}

{$LAZO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
		-X-Powered-By
	}
	# El panel y la API de administración de PocketBase no se publican: entra por túnel SSH, la LAN o HEIMDALL (VPN).
	# Incluye la gestión de colecciones (/api/collections, /api/collections/{c}, …/truncate, import), que no tiene «/records».
	@admin path /_ /_/* /api/settings* /api/logs* /api/backups* /api/crons* /api/collections/_* /api/collections/import* /api/collections/meta/*
	# Lista blanca (V-16): solo las colecciones y rutas que usa la app. PocketBase acepta la colección por nombre
	# o por id, y el id de _superusers (pbc_3142635823) es fijo: bloquear por nombre no bastaba.
	@adminCollections {
		path /api/collections /api/collections/*
		not path_regexp ^/api/collections/(users|groups|lists|items|claims|contributions|budgets|payments|draws|assignments|joinRequests)/(records(/[A-Za-z0-9_]+)?|auth-refresh)$
	}
	respond @admin 404
	respond @adminCollections 404
	reverse_proxy pocketbase:8090 {
		# Una sola IP, la ya resuelta: PocketBase lee la de más a la derecha (trustedProxy).
		header_up X-Forwarded-For {client_ip}
	}
}
