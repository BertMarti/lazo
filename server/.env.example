# Copia este archivo como .env (no se sube a git: el repositorio es público) y rellena lo que uses.
# Guía: docs/HOMELAB.md. Nunca pegues aquí valores reales en un commit.

# — Servidor (docker compose en el homelab) —
# Dominio público de tu Lazo, sin https:// (p. ej. milazo.duckdns.org o lazo.tudominio.es).
# Con Cloudflare Tunnel, ponle delante http:// (http://lazo.tudominio.es): el certificado lo pone Cloudflare.
LAZO_DOMAIN=
# Clave interna entre PocketBase y el servicio de enlaces. Genérala con: openssl rand -hex 32
UNFURL_KEY=
TZ=Europe/Madrid

# Dónde escucha Caddy. 0.0.0.0 si abres los puertos 80 y 443 en el router; 127.0.0.1 con Cloudflare Tunnel.
LAZO_BIND=0.0.0.0

# Opcionales que se arrancan con el resto: vacío, duckdns, tunnel o duckdns,tunnel
COMPOSE_PROFILES=

# — Copias de seguridad (contenedor lazo-backup) —
# Cuándo (formato cron, hora de TZ) y cuántas se guardan. Por defecto: cada día a las 3:30, las 14 últimas.
BACKUP_CRON=30 3 * * *
BACKUP_KEEP=14

# — DuckDNS (perfil duckdns) — de https://www.duckdns.org, tras entrar con tu cuenta
# Solo el nombre, sin .duckdns.org
DUCKDNS_SUBDOMAIN=milazo
DUCKDNS_TOKEN=pon-aqui-tu-token-de-duckdns

# — Cloudflare Tunnel (perfil tunnel) — Zero Trust → Networks → Tunnels → tu túnel → token
TUNNEL_TOKEN=pon-aqui-el-token-del-tunel

# — Solo para desarrollo: probar la IA real en local (la app guarda la clave en el dispositivo) —
# Gemini: https://aistudio.google.com/apikey  ·  NVIDIA: https://build.nvidia.com
GEMINI_API_KEY=
NVIDIA_API_KEY=
