{
  "name": "lazo",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "dev:demo": "VITE_DEMO=1 vite",
    "build": "tsc -b && vite build",
    "build:demo": "VITE_DEMO=1 vite build --outDir dist-demo",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "eslint . && tsc -b && vitest run",
    "e2e": "playwright test",
    "build:server": "esbuild src/core/meta.ts --bundle --format=esm --platform=node --outfile=server/unfurl/meta.mjs && esbuild src/core/amazonServidor.ts --bundle --format=esm --platform=node --outfile=server/unfurl/amazon.mjs && esbuild src/core/draw.ts --bundle --format=cjs --platform=neutral --target=es2020 --outfile=server/pb/pb_hooks/lib/draw.cjs && esbuild src/core/plazas.ts --bundle --format=cjs --platform=neutral --target=es2020 --outfile=server/pb/pb_hooks/lib/plazas.cjs && esbuild src/core/copia.ts --bundle --format=cjs --platform=neutral --target=es2020 --outfile=server/pb/pb_hooks/lib/copia.cjs",
    "test:live": "vitest run test/integration",
    "test:server": "node --test server/unfurl/test/*.test.mjs",
    "rendimiento": "node scripts/rendimiento.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "pocketbase": "^0.28.2",
    "qrcode-generator": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
