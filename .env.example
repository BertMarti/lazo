# Copia este archivo como .env (no se sube a git) y rellena lo que uses. Ninguna clave es obligatoria.

# — Servidor (docker compose en el homelab) —
# Dominio público de tu Lazo (DuckDNS o el tuyo), sin https://
LAZO_DOMAIN=
# Clave interna entre PocketBase y el servicio de enlaces. Genérala con: openssl rand -hex 32
UNFURL_KEY=
TZ=Europe/Madrid

# — Solo para desarrollo: probar la IA real en local (la app guarda la clave en el dispositivo) —
# Gemini: https://aistudio.google.com/apikey  ·  NVIDIA: https://build.nvidia.com
GEMINI_API_KEY=
NVIDIA_API_KEY=
