#!/usr/bin/env bash
# Escaneo de secretos antes de cada commit. Activar una vez: git config core.hooksPath .githooks
set -euo pipefail
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --staged --redact --no-banner
fi
# Sin gitleaks instalado: comprobación mínima de los formatos de clave que usa Lazo.
pattern='(AIza[0-9A-Za-z_-]{35}|sk-ant-[0-9A-Za-z_-]{20,}|nvapi-[0-9A-Za-z_-]{20,}|gsk_[0-9A-Za-z]{20,}|sk-or-v1-[0-9a-f]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -qE "$pattern"; then
  echo "pre-commit: parece que vas a subir una clave. Quítala (va en .env, que no se sube)." >&2
  exit 1
fi
